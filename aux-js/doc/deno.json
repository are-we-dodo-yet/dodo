{
  "name": "@deno/doc",
  "version": "0.0.0",
  "exports": {
    ".": "./mod.ts",
    "./types": "./types.d.ts",
    "./html-types": "./html_types.d.ts"
  },
  "tasks": {
    "build": "deno run -A jsr:@deno/wasmbuild@0.23.0 --project deno_doc_wasm",
    "test": "deno test -A",
    "tailwind": "deno run -A build_css.ts",
    "gen_html": "cargo run --example ddoc -- doc --name=gen_html --output generated_docs/ --html",
    "debug": "deno task tailwind && deno task gen_html ./tests/testdata/multiple/[!_]*",
    "test:update": "UPDATE=1 cargo test --locked --all-targets && cargo insta test --accept"
  },
  "exclude": ["target", "benches/fixtures"],
  "fmt": {
    "exclude": [
      "**/*.gen.css",
      "generated_docs",
      "tests/testdata/@zod_zod_4.3.6_raw.json"
    ]
  },
  "lint": {
    "exclude": ["src/html", "tests/testdata"]
  },
  "links": [
    "../graph"
  ],
  "imports": {
    "@david/dax": "jsr:@david/dax@0.43.2",
    "@deno/cache-dir": "jsr:@deno/cache-dir@^0.25.0",
    "@std/assert": "jsr:@std/assert@1",
    "browserslist": "npm:browserslist@4.23.0",
    "lightningcss": "npm:lightningcss@^1.26.0",
    "tailwindcss": "npm:tailwindcss@3.4.3"
  }
}
